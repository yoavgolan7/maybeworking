<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.cell.CheckBoxTableCell?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.maybeworking.HelloController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Task Name:"/>
    <TextField fx:id="taskNameField"/>
    <Label text="Worker Name:"/>
    <TextField fx:id="workerNameField"/>
    <HBox spacing="10">
        <Button text="Add Task" onAction="#handleAddTask"/>
        <Button text="Save Tasks" onAction="#handleSaveTasks"/>
    </HBox>
    <TableView fx:id="taskTableView">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="100"/>
            <TableColumn fx:id="workerColumn" text="Worker" prefWidth="100"/>
            <TableColumn fx:id="completeColumn" text="Complete" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>